<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="900.0" spacing="15.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.controllers.GestioneRevisioniProfFXController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Capitoli da correggere">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <TableView fx:id="tabellaRevisioni" prefHeight="280.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTesi" prefWidth="180.0" text="Tesi" />
            <TableColumn fx:id="colNumCapitolo" prefWidth="90.0" text="N° Capitolo" />
            <TableColumn fx:id="colTitolo" prefWidth="200.0" text="Titolo" />
            <TableColumn fx:id="colStato" prefWidth="130.0" text="Stato" />
            <TableColumn fx:id="colData" prefWidth="130.0" text="Data Invio" />
        </columns>
    </TableView>

    <Button mnemonicParsing="false" onAction="#apriPdf" text="Apri PDF capitolo selezionato" />

    <Label text="Note di correzione">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Label>
    <TextArea fx:id="txtNote" prefHeight="120.0" promptText="Scrivi qui le note per lo studente..." wrapText="true" />

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Stato:" />
        <ComboBox fx:id="comboStato" prefWidth="200.0" promptText="Seleziona stato" />
        <Button mnemonicParsing="false" onAction="#salvaCorrezione" text="Salva correzione" />
    </HBox>

    <Button mnemonicParsing="false" onAction="#handleIndietro" text="Torna al menu" />

</VBox>