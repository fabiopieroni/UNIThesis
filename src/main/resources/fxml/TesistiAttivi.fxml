<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ui.controllers.TesistiAttiviController">
    <padding>
        <Insets top="30.0" right="30.0" bottom="30.0" left="30.0"/>
    </padding>

    <Label text="I miei Tesisti" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Doppio click su una riga per vedere i capitoli da correggere" style="-fx-text-fill: gray;"/>

    <TableView fx:id="tabellaTesisti" prefHeight="400.0">
        <columns>
            <TableColumn fx:id="colNome" text="Studente" prefWidth="200.0"/>
            <TableColumn fx:id="colTesi" text="Tesi" prefWidth="280.0"/>
            <TableColumn fx:id="colStatoTesi" text="Stato Tesi" prefWidth="120.0"/>
            <TableColumn fx:id="colAzioni" text="Azioni" prefWidth="180.0"/>
        </columns>
    </TableView>

    <Button text="Torna al menu" onAction="#handleIndietro"/>
</VBox>